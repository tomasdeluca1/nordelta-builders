# Neon Postgres connection string
# Get it from https://console.neon.tech → your project → Connection Details → "Pooled connection"
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# Session secret — 32+ chars. Generate with:  openssl rand -base64 48
SESSION_PASSWORD="change-me-please-this-must-be-at-least-32-chars-long"

# Resend API key — https://resend.com/api-keys
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxx"

# Verified sender (must match a domain you've verified in Resend, e.g. nordelta.tech)
EMAIL_FROM="Nordelta Tech <onboarding@huevsite.studio>"

# Public app URL — used in emails and metadata
APP_URL="https://nordelta.tech"
