# Neon Postgres connection string
# Get it from https://console.neon.tech → your project → Connection Details → "Pooled connection"
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# Session secret — 32+ chars. Generate with:  openssl rand -base64 48
SESSION_PASSWORD="change-me-please-this-must-be-at-least-32-chars-long"

# Resend API key — https://resend.com/api-keys
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxx"

# Remitente. `onboarding@resend.dev` es el dominio compartido de Resend: sirve para
# probar, pero SOLO entrega al email dueño de la cuenta de Resend. Para mandarles
# mails a los builders hace falta un dominio propio verificado en Resend (SPF/DKIM);
# `bsasnortetech.vercel.app` no se puede verificar porque no da acceso al DNS.
EMAIL_FROM="Norte Tech <onboarding@resend.dev>"

# Public app URL — used in emails and metadata
APP_URL="https://bsasnortetech.vercel.app"
